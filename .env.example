VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- /speak (premium AI speaking partner) ---------------------------------
# Client (Vite). Dev only: set to 1 to run /speak against canned responses
# without Supabase or any AI provider. Ignored by production builds.
VITE_SPEAK_MOCK=
# Edge Function secrets for `speak-turn` (never in the client bundle; set with
# `supabase secrets set NAME=value`). OPENAI_API_KEY and ANTHROPIC_API_KEY are
# the keys the existing `transcribe` and `EnglishX50feedback` functions use.
#   OPENAI_API_KEY=            Whisper speech-to-text + TTS
#   ANTHROPIC_API_KEY=         Claude conversation turn
#   SPEAK_MODEL=               optional, default claude-opus-5
#   SPEAK_MODEL_EFFORT=        optional, default low ('off' to omit)
#   SPEAK_STT_MODEL=           optional, default whisper-1
#   SPEAK_TTS_PROVIDER=        optional, openai | none (default openai)
#   SPEAK_TTS_MODEL=           optional, default gpt-4o-mini-tts
#   SPEAK_TTS_VOICE=           optional, default nova
#   SPEAK_MOCK_MODE=           optional, 'true' → canned providers (dev only)
